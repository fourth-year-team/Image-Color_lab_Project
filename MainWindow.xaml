<Window x:Class="ImageLabProject.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="http://helix-toolkit.org/wpf"
        Title="Image Lab Pro"
        Height="900"
        Width="1600"
        WindowStartupLocation="CenterScreen"
        Background="#0D1117"
        FontFamily="Segoe UI">

    <Window.Resources>

        <SolidColorBrush x:Key="Bg" Color="#0D1117"/>
        <SolidColorBrush x:Key="Panel" Color="#161B22"/>
        <SolidColorBrush x:Key="Panel2" Color="#1C2128"/>
        <SolidColorBrush x:Key="BorderSoft" Color="#30363D"/>

        <SolidColorBrush x:Key="AccentBlue" Color="#3B82F6"/>
        <SolidColorBrush x:Key="AccentPurple" Color="#8B5CF6"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#10B981"/>

        <Style x:Key="ModernSlider" TargetType="Slider">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto" MinHeight="{TemplateBinding MinHeight}"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <Border x:Name="TrackBackground" 
                                    Grid.Row="1" 
                                    Height="4" 
                                    Margin="5,0"
                                    Background="#4B5563" 
                                    CornerRadius="2" 
                                    VerticalAlignment="Center"/>
                            
                            <Track x:Name="PART_Track" Grid.Row="1">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Background="Transparent" BorderBrush="Transparent"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Background="Transparent" BorderBrush="Transparent"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="12" Height="20" Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#E5E7EB" CornerRadius="1"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Cursor" Value="Hand"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="Background" Value="#1C2128"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                CornerRadius="10"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#252C36"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderBrush" Value="#2563EB"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="90"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="430"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#11161D" BorderBrush="#30363D" BorderThickness="0,0,1,0">
            <StackPanel Margin="14">
                <Border Width="56" Height="56" CornerRadius="18" Background="#2563EB" Margin="0,10,0,24">
                    <TextBlock Text="IL" Foreground="White" FontWeight="Bold" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Button Content="📂" FontSize="18" Style="{StaticResource PrimaryButton}" Click="BtnImport_Click"/>
                <Button Content="💾" FontSize="18" Style="{StaticResource ModernButton}" Click="BtnSave_Click"/>
                <Button Content="↺" FontSize="18" Style="{StaticResource ModernButton}" Click="BtnReset_Click"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="190"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#161B22" CornerRadius="18" BorderBrush="#30363D" BorderThickness="1">
                <Grid Margin="22,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="11" Height="11" Fill="#FF5F57" Margin="0,0,8,0"/>
                        <Ellipse Width="11" Height="11" Fill="#FEBC2E" Margin="0,0,8,0"/>
                        <Ellipse Width="11" Height="11" Fill="#28C840"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="IMAGE LAB PRO" Foreground="White" FontWeight="Bold" FontSize="24"/>
                        <TextBlock Text="Advanced Color Processing" Foreground="#60A5FA" FontSize="11" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <Border Grid.Column="2" Width="110" Height="34" CornerRadius="10" Background="#0F172A" VerticalAlignment="Center">
                        <TextBlock Text="REALTIME" Foreground="#10B981" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="1" Margin="0,20,0,0" Background="#050B16" CornerRadius="24" BorderBrush="#30363D" BorderThickness="1" AllowDrop="True" DragOver="ImageControl_DragOver" Drop="ImageControl_Drop">
                <Grid>
                    <Border Height="58" VerticalAlignment="Top" Background="#111827" CornerRadius="24,24,0,0" BorderBrush="#30363D" BorderThickness="0,0,0,1">
                        <Grid Margin="20,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="IMAGE VIEWPORT" Foreground="White" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Width="90" Height="30" Background="#1D4ED8" CornerRadius="10" VerticalAlignment="Center">
                                <TextBlock Text="LIVE" Foreground="White" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <StackPanel x:Name="PlaceholderText" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="DROP IMAGE HERE" Foreground="#334155" FontWeight="Bold" FontSize="38" HorizontalAlignment="Center"/>
                        <TextBlock Text="Drag &amp; Drop or Import" Foreground="#64748B" FontSize="15" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <Image x:Name="DisplayedImage" Margin="30" Stretch="Uniform" Cursor="Cross" MouseLeftButtonDown="DisplayedImage_MouseLeftButtonDown"/>
                </Grid>
            </Border>

            <Border Grid.Row="2" Margin="0,20,0,0" Background="#161B22" CornerRadius="24" BorderBrush="#30363D" BorderThickness="1" Padding="18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="2.2*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="FILE" Foreground="#6B7280" FontWeight="Bold" FontSize="10"/>
                        <TextBlock x:Name="TxtFileName" Foreground="White" FontWeight="SemiBold" FontSize="13" Margin="0,10,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="SIZE" Foreground="#6B7280" FontWeight="Bold" FontSize="10"/>
                        <TextBlock x:Name="TxtFileSize" Foreground="White" FontWeight="SemiBold" FontSize="13" Margin="0,10,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="DIMENSIONS" Foreground="#6B7280" FontWeight="Bold" FontSize="10"/>
                        <TextBlock x:Name="TxtDimensions" Foreground="White" FontWeight="SemiBold" FontSize="13" Margin="0,10,0,0"/>
                    </StackPanel>

                    <Grid Grid.Column="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <Border x:Name="SelectedColorPreview" Width="70" Height="70" CornerRadius="16" Background="#1E293B" BorderBrush="#3B82F6" BorderThickness="2"/>
                            <TextBlock x:Name="HexColorText" Text="#FFFFFF" Foreground="White" FontWeight="Bold" FontSize="18" Margin="0,12,0,0"/>
                        </StackPanel>

                        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10,0,0,0">
                                <Border Background="#0F172A" CornerRadius="10" Padding="10" Margin="0,0,0,8">
                                    <Grid>
                                        <TextBlock Text="RGB" Foreground="#60A5FA" FontWeight="Bold"/>
                                        <TextBlock x:Name="RgbLabel" Text="(0,0,0)" Foreground="White" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>
                                <Border Background="#0F172A" CornerRadius="10" Padding="10" Margin="0,0,0,8">
                                    <Grid>
                                        <TextBlock Text="HSV" Foreground="#10B981" FontWeight="Bold"/>
                                        <TextBlock x:Name="HsvLabel" Text="(0°,0%,0%)" Foreground="White" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>
                                <Border Background="#0F172A" CornerRadius="10" Padding="10" Margin="0,0,0,8">
                                    <Grid>
                                        <TextBlock Text="YCbCr" Foreground="#F59E0B" FontWeight="Bold"/>
                                        <TextBlock x:Name="YcbcrLabel" Text="(0,0,0)" Foreground="White" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>
                                <Border Background="#0F172A" CornerRadius="10" Padding="10">
                                    <Grid>
                                        <TextBlock Text="CMYK" Foreground="#EC4899" FontWeight="Bold"/>
                                        <TextBlock x:Name="CmykLabel" Text="(0%,0%,0%,100%)" Foreground="White" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Column="2" Background="#11161D" BorderBrush="#30363D" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                <StackPanel>
                    
                    <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="IMAGE ADJUSTMENTS" Style="{StaticResource SectionTitle}"/>
                            
                            <TextBlock Text="Brightness" Foreground="White" FontSize="12"/>
                            <Slider x:Name="BrightnessSlider" Style="{StaticResource ModernSlider}" Minimum="-1" Maximum="1" Value="0" TickFrequency="0.01" ValueChanged="Slider_ValueChanged" Margin="0,4,0,10"/>

                            <TextBlock Text="Contrast" Foreground="White" FontSize="12"/>
                            <Slider x:Name="ContrastSlider" Style="{StaticResource ModernSlider}" Minimum="-1" Maximum="1" Value="0" TickFrequency="0.01" ValueChanged="Slider_ValueChanged" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="COLOR SPACES MAPS" Style="{StaticResource SectionTitle}"/>
                            <WrapPanel ItemWidth="174" ItemHeight="48" HorizontalAlignment="Center">
                                <Button Content="GRAYSCALE" Style="{StaticResource ModernButton}" Click="BtnGrayscale_Click" Margin="0,0,4,8"/>
                                <Button Content="HSV SHIFT" Style="{StaticResource ModernButton}" Click="BtnToHSV_Click" Margin="4,0,0,8"/>
                                <Button Content="CMYK" Style="{StaticResource ModernButton}" Click="BtnToCMYK_Click" Margin="0,0,4,8"/>
                                <Button Content="YCbCr" Style="{StaticResource ModernButton}" Click="BtnToYCbCr_Click" Margin="4,0,0,8"/>
                                <Button Content="CIELab" Style="{StaticResource ModernButton}" Click="BtnToLab_Click" Margin="0,0,4,8"/>
                                <Button Content="YUV" Style="{StaticResource ModernButton}" Click="BtnToYUV_Click" Margin="4,0,0,8"/>
                            </WrapPanel>
                            <Button Content="EXTRACT RED CHANNEL" Style="{StaticResource ModernButton}" Click="BtnExtractRed_Click" Margin="2,0,2,0" Width="346" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,0,16">
                        <StackPanel x:Name="ChannelsPanel">
                            <TextBlock x:Name="TxtChannelsTitle" Text="RGB CHANNELS &amp; QUANTIZATION" Style="{StaticResource SectionTitle}" Foreground="#60A5FA"/>

                            <TextBlock x:Name="LblCh1" Text="Red Channel" Foreground="#CBD5E1" FontSize="12"/>
                            <Slider x:Name="SliderCh1" Style="{StaticResource ModernSlider}" Minimum="0" Maximum="2" Value="1" TickFrequency="0.01" ValueChanged="ChannelSlider_ValueChanged" Margin="0,4,0,10"/>

                            <TextBlock x:Name="LblCh2" Text="Green Channel" Foreground="#CBD5E1" FontSize="12"/>
                            <Slider x:Name="SliderCh2" Style="{StaticResource ModernSlider}" Minimum="0" Maximum="2" Value="1" TickFrequency="0.01" ValueChanged="ChannelSlider_ValueChanged" Margin="0,4,0,10"/>

                            <TextBlock x:Name="LblCh3" Text="Blue Channel" Foreground="#CBD5E1" FontSize="12"/>
                            <Slider x:Name="SliderCh3" Style="{StaticResource ModernSlider}" Minimum="0" Maximum="2" Value="1" TickFrequency="0.01" ValueChanged="ChannelSlider_ValueChanged" Margin="0,4,0,14"/>

                            <Border Background="#1C2128" BorderBrush="#30363D" BorderThickness="1" CornerRadius="10" Padding="12">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="Quantization Levels" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="lblLevels" Text="256" Foreground="#60A5FA" FontWeight="Bold" DockPanel.Dock="Right"/>
                                    </DockPanel>
                                    <Slider x:Name="SliderLevels" Style="{StaticResource ModernSlider}" Minimum="2" Maximum="256" Value="256" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SliderLevels_ValueChanged"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="14" Padding="16">
                        <StackPanel>
                            <TextBlock Text="3D RGB SPACE INTERACTIVE" Style="{StaticResource SectionTitle}"/>
                            <Border Height="220" Background="#050B16" BorderBrush="#30363D" BorderThickness="1" CornerRadius="10">
                                <Grid>
                                    <h:HelixViewport3D x:Name="RgbViewport" Background="#050B16" ZoomExtentsWhenLoaded="True" Margin="4">
                                        <h:SunLight/>
                                    </h:HelixViewport3D>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                    
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>