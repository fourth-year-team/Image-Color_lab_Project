<Window x:Class="ImageLabProject.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:h="http://helix-toolkit.org/wpf"
        Title="Image Lab Pro"
        Height="850"
        Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="#0B0F17">

    <Window.Resources>

        <!-- COLORS -->

        <SolidColorBrush x:Key="PrimaryBg" Color="#0B0F17"/>
        <SolidColorBrush x:Key="SecondaryBg" Color="#121826"/>
        <SolidColorBrush x:Key="CardBg" Color="#161D2E"/>
        <SolidColorBrush x:Key="BorderBrushColor" Color="#243044"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#3B82F6"/>
        <SolidColorBrush x:Key="AccentHover" Color="#2563EB"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F3F4F6"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#9CA3AF"/>

        <!-- BUTTON STYLE -->

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>

                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1E293B"/>
                </Trigger>

            </Style.Triggers>

        </Style>

        <!-- ACCENT BUTTON -->

        <Style x:Key="AccentButton"
               TargetType="Button"
               BasedOn="{StaticResource ModernButton}">

            <Setter Property="Background" Value="{StaticResource AccentBlue}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
            <Setter Property="Foreground" Value="White"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentHover}"/>
                </Trigger>

            </Style.Triggers>

        </Style>

        <!-- SECTION TITLE -->

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,25,0,10"/>
        </Style>

        <!-- SLIDER -->

        <Style TargetType="Slider">
            <Setter Property="Margin" Value="0,5,0,15"/>
        </Style>

    </Window.Resources>

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT PANEL -->

        <Grid Grid.Column="0" Margin="24">

  <Grid.RowDefinitions>
    <RowDefinition Height="7*"/>
    <RowDefinition Height="220"/>
    <RowDefinition Height="180"/>
</Grid.RowDefinitions>

            <!-- IMAGE VIEWER -->

            <Border Grid.Row="0"
                    Background="#060A13"
                    BorderBrush="{StaticResource BorderBrushColor}"
                    BorderThickness="1"
                    CornerRadius="24"
                    AllowDrop="True"
                    DragOver="ImageControl_DragOver"
                    Drop="ImageControl_Drop">

                <Grid>

                    <!-- TOP BAR -->

                    <Border VerticalAlignment="Top"
                            Height="60"
                            Background="#101827"
                            CornerRadius="24,24,0,0"
                            BorderBrush="{StaticResource BorderBrushColor}"
                            BorderThickness="0,0,0,1">

                        <DockPanel Margin="20,0">

                            <StackPanel Orientation="Horizontal">

                                <Ellipse Width="12"
                                         Height="12"
                                         Fill="#EF4444"
                                         Margin="0,0,8,0"/>

                                <Ellipse Width="12"
                                         Height="12"
                                         Fill="#F59E0B"
                                         Margin="0,0,8,0"/>

                                <Ellipse Width="12"
                                         Height="12"
                                         Fill="#10B981"/>

                            </StackPanel>

                            <TextBlock Text="IMAGE LAB PRO"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       FontSize="15"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>

                        </DockPanel>

                    </Border>
                          
                    <!-- PLACEHOLDER -->

                    <StackPanel x:Name="PlaceholderText"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">

                        <TextBlock Text="DROP IMAGE HERE"
                                   FontSize="34"
                                   FontWeight="Bold"
                                   Foreground="#334155"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Drag &amp; Drop or Import an Image"
                                   FontSize="15"
                                   Foreground="#64748B"
                                   Margin="0,12,0,0"
                                   HorizontalAlignment="Center"/>

                    </StackPanel>

                    <!-- IMAGE -->

                    <Image x:Name="DisplayedImage"
                           Stretch="Uniform"
                           Margin="30"
                           Cursor="Cross"
                           MouseLeftButtonDown="DisplayedImage_MouseLeftButtonDown"/>

                </Grid>

            </Border>
            <Border Grid.Row="1"
        Margin="0,20,0,0"
        Background="{StaticResource SecondaryBg}"
        CornerRadius="20"
        BorderBrush="{StaticResource BorderBrushColor}"
        BorderThickness="1">

    <Grid>

        <TextBlock Text="RGB COLOR SPACE"
                Foreground="White"
                FontWeight="Bold"
                FontSize="18"
                Margin="20,15,0,0"
                VerticalAlignment="Top"/>

        <h:HelixViewport3D x:Name="RgbViewport"
                        Margin="10,50,10,10"
                        Background="#0A0F18"
                        ZoomExtentsWhenLoaded="True">

            <h:SunLight/>

        </h:HelixViewport3D>

    </Grid>

</Border>
            <!-- STATUS / INFO -->

            <Border Grid.Row="2"
                    Margin="0,20,0,0"
                    Background="{StaticResource SecondaryBg}"
                    CornerRadius="20"
                    BorderBrush="{StaticResource BorderBrushColor}"
                    BorderThickness="1">

                <Grid Margin="25">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.4*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1.6*"/>
                    </Grid.ColumnDefinitions>

                    <!-- FILE -->

                    <StackPanel>

                        <TextBlock Text="FILE"
                                   Foreground="#64748B"
                                   FontSize="11"/>

                        <TextBlock x:Name="TxtFileName"
                                   Foreground="White"
                                   FontSize="14"
                                   FontWeight="SemiBold"/>

                    </StackPanel>

                    <!-- SIZE -->

                    <StackPanel Grid.Column="1">

                        <TextBlock Text="SIZE"
                                   Foreground="#64748B"
                                   FontSize="11"/>

                        <TextBlock x:Name="TxtFileSize"
                                   Foreground="White"
                                   FontSize="14"
                                   FontWeight="SemiBold"/>

                    </StackPanel>

                    <!-- DIMENSIONS -->

                    <StackPanel Grid.Column="2">

                        <TextBlock Text="DIMENSIONS"
                                   Foreground="#64748B"
                                   FontSize="11"/>

                        <TextBlock x:Name="TxtDimensions"
                                   Foreground="White"
                                   FontSize="14"
                                   FontWeight="SemiBold"/>

                    </StackPanel>

                    <!-- COLOR INFO -->

                    <StackPanel Grid.Column="3">

                        <StackPanel Orientation="Horizontal">

                            <Border x:Name="SelectedColorPreview"
                                    Width="42"
                                    Height="42"
                                    Background="Gray"
                                    BorderBrush="White"
                                    BorderThickness="2"
                                    CornerRadius="8"
                                    Margin="0,0,12,0"/>

                            <StackPanel>

                                <TextBlock Text="SELECTED COLOR"
                                           Foreground="#64748B"
                                           FontSize="10"/>

                                <TextBlock x:Name="HexColorText"
                                           Text="#FFFFFF"
                                           Foreground="White"
                                           FontWeight="Bold"
                                           FontSize="14"/>

                            </StackPanel>

                        </StackPanel>

                        <WrapPanel Margin="0,15,0,0">

                            <Border Background="#1E293B"
                                    CornerRadius="8"
                                    Padding="10"
                                    Margin="0,0,8,8">

                                <TextBlock x:Name="RgbLabel"
                                           Text="RGB: (0,0,0)"
                                           Foreground="White"/>

                            </Border>

                            <Border Background="#1E293B"
                                    CornerRadius="8"
                                    Padding="10"
                                    Margin="0,0,8,8">

                                <TextBlock x:Name="HsvLabel"
                                           Text="HSV: (0°,0%,0%)"
                                           Foreground="White"/>

                            </Border>

                            <Border Background="#1E293B"
                                    CornerRadius="8"
                                    Padding="10"
                                    Margin="0,0,8,8">

                                <TextBlock x:Name="YcbcrLabel"
                                           Text="YCbCr: (0,0,0)"
                                           Foreground="White"/>

                            </Border>

                            <Border Background="#1E293B"
                                    CornerRadius="8"
                                    Padding="10">

                                <TextBlock x:Name="CmykLabel"
                                           Text="CMYK: (0%,0%,0%,100%)"
                                           Foreground="White"/>

                            </Border>

                        </WrapPanel>

                    </StackPanel>

                </Grid>

            </Border>

        </Grid>

        <!-- RIGHT SIDEBAR -->

        <Border Grid.Column="1"
                Background="{StaticResource SecondaryBg}"
                BorderBrush="{StaticResource BorderBrushColor}"
                BorderThickness="1,0,0,0">

            <ScrollViewer VerticalScrollBarVisibility="Auto">

                <StackPanel Margin="24">

                    <!-- HEADER -->

                    <TextBlock Text="IMAGE LAB"
                               Foreground="White"
                               FontSize="28"
                               FontWeight="Bold"/>

                    <TextBlock Text="Advanced Color Processing"
                               Foreground="{StaticResource AccentBlue}"
                               Margin="0,4,0,25"
                               FontSize="13"/>

                    <!-- ACTION BUTTONS -->

                    <UniformGrid Columns="2">

                        <Button Content="IMPORT"
                                Style="{StaticResource AccentButton}"
                                Click="BtnImport_Click"/>

                        <Button Content="RESET"
                                Style="{StaticResource ModernButton}"
                                Foreground="#F87171"
                                Click="BtnReset_Click"/>

                    </UniformGrid>

                    <Button Content="EXPORT IMAGE"
                            Height="48"
                            Margin="5,12,5,25"
                            Style="{StaticResource AccentButton}"
                            Click="BtnSave_Click"/>

                    <!-- ADJUSTMENTS -->

                    <TextBlock Text="IMAGE ADJUSTMENTS"
                               Style="{StaticResource SectionTitle}"/>

                    <TextBlock Text="Brightness"
                               Foreground="White"/>

                    <Slider x:Name="BrightnessSlider"
                            Minimum="-1"
                            Maximum="1"
                            Value="0"
                            TickFrequency="0.01"
                            SmallChange="0.01"
                            LargeChange="0.1"
                            IsSnapToTickEnabled="False"
                            ValueChanged="Slider_ValueChanged"/>

                    <TextBlock Text="Contrast"
                               Foreground="White"/>

                    <Slider x:Name="ContrastSlider"
                            Minimum="-1"
                            Maximum="1"
                            Value="0"
                            TickFrequency="0.01"
                            SmallChange="0.01"
                            LargeChange="0.1"
                            IsSnapToTickEnabled="False"
                            ValueChanged="Slider_ValueChanged"/>

                    <!-- COLOR SPACES -->

                    <TextBlock Text="COLOR SPACES"
                               Style="{StaticResource SectionTitle}"/>

                    <UniformGrid Columns="2">

                        <Button Content="GRAYSCALE"
                                Style="{StaticResource ModernButton}"
                                Click="BtnGrayscale_Click"/>

                        <Button Content="HSV SHIFT"
                                Style="{StaticResource ModernButton}"
                                Click="BtnToHSV_Click"/>

                        <Button Content="CMYK"
                                Style="{StaticResource ModernButton}"
                                Click="BtnToCMYK_Click"/>

                        <Button Content="YCbCr"
                                Style="{StaticResource ModernButton}"
                                Click="BtnToYCbCr_Click"/>

                        <Button Content="CIELab"
                                Style="{StaticResource ModernButton}"
                                Click="BtnToLab_Click"/>

                        <Button Content="RED CHANNEL"
                                Foreground="#F87171"
                                Style="{StaticResource ModernButton}"
                                Click="BtnExtractRed_Click"/>

                        <Button Content="YUV"
                                Style="{StaticResource ModernButton}"
                                Click="BtnToYUV_Click"/>

                    </UniformGrid>

                    <!-- CHANNEL PANEL -->

                    <Border Background="{StaticResource CardBg}"
                            CornerRadius="18"
                            BorderBrush="{StaticResource BorderBrushColor}"
                            BorderThickness="1"
                            Margin="0,25,0,0"
                            Padding="18">

                        <StackPanel x:Name="ChannelsPanel">

                            <TextBlock x:Name="TxtChannelsTitle"
                                       Text="RGB CHANNELS"
                                       Foreground="{StaticResource AccentBlue}"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       Margin="0,0,0,16"/>

                            <TextBlock x:Name="LblCh1"
                                       Text="Red"
                                       Foreground="#CBD5E1"/>

                            <Slider x:Name="SliderCh1"
                                    Minimum="0"
                                    Maximum="2"
                                    Value="1"
                                    TickFrequency="0.01"
                                    IsSnapToTickEnabled="False"
                                    ValueChanged="ChannelSlider_ValueChanged"/>

                            <TextBlock x:Name="LblCh2"
                                       Text="Green"
                                       Foreground="#CBD5E1"/>

                            <Slider x:Name="SliderCh2"
                                    Minimum="0"
                                    Maximum="2"
                                    Value="1"
                                    TickFrequency="0.01"
                                    IsSnapToTickEnabled="False"
                                    ValueChanged="ChannelSlider_ValueChanged"/>

                            <TextBlock x:Name="LblCh3"
                                       Text="Blue"
                                       Foreground="#CBD5E1"/>

                            <Slider x:Name="SliderCh3"
                                    Minimum="0"
                                    Maximum="2"
                                    Value="1"
                                    TickFrequency="0.01"
                                    IsSnapToTickEnabled="False"
                                    ValueChanged="ChannelSlider_ValueChanged"/>

                        </StackPanel>

                    </Border>

                    <!-- QUANTIZATION -->

                    <Border Background="{StaticResource CardBg}"
                            CornerRadius="18"
                            BorderBrush="{StaticResource BorderBrushColor}"
                            BorderThickness="1"
                            Margin="0,20,0,20"
                            Padding="18">

                        <StackPanel>

                            <TextBlock Text="COLOR QUANTIZATION"
                                       Foreground="{StaticResource AccentBlue}"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       Margin="0,0,0,16"/>

                            <DockPanel>

                                <TextBlock Text="Levels"
                                           Foreground="White"
                                           VerticalAlignment="Center"/>

                                <TextBlock x:Name="lblLevels"
                                           Text="256"
                                           Foreground="White"
                                           FontWeight="Bold"
                                           DockPanel.Dock="Right"/>

                            </DockPanel>

                            <Slider x:Name="SliderLevels"
                                    Minimum="2"
                                    Maximum="256"
                                    Value="256"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    ValueChanged="SliderLevels_ValueChanged"/>

                        </StackPanel>

                    </Border>

                </StackPanel>

            </ScrollViewer>

        </Border>

    </Grid>

</Window>