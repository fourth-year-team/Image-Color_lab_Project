
<Window x:Class="ImageLabProject.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="http://helix-toolkit.org/wpf"
        Title="Image Lab Pro"
        Height="900"
        Width="1600"
        WindowStartupLocation="CenterScreen"
        Background="#020307"
        FontFamily="Segoe UI">

    <Window.Resources>

        <!-- BACKGROUND -->

        <LinearGradientBrush x:Key="MainBackground"
                             StartPoint="0,0"
                             EndPoint="1,1">
            <GradientStop Color="#010104" Offset="0"/>
            <GradientStop Color="#050816" Offset="0.5"/>
            <GradientStop Color="#000000" Offset="1"/>
        </LinearGradientBrush>


        <!-- GLASS PANEL -->

        <Style x:Key="GlassCard" TargetType="Border">
            <Setter Property="Background" Value="#0BFFFFFF"/>
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="BorderBrush" Value="#18FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>

            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="30"
                                      ShadowDepth="0"
                                      Color="#2200D9FF"
                                      Opacity="0.7"/>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- BUTTON -->

        <Style x:Key="NeonButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#10FFFFFF"/>
            <Setter Property="BorderBrush" Value="#18FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">

                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18"
                                                  ShadowDepth="0"
                                                  Color="#2200FFFF"/>
                            </Border.Effect>

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="Root"
                                        Property="Opacity"
                                        Value="0.85"/>
                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="Root"
                                        Property="Opacity"
                                        Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- SLIDER -->

        <Style x:Key="ModernSlider" TargetType="Slider">
            <Setter Property="Height" Value="24"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Slider">

                        <Grid>

                            <Border Height="8"
                                    Background="#18FFFFFF"
                                    CornerRadius="4"
                                    VerticalAlignment="Center"/>

                            <Track x:Name="PART_Track">

                                <Track.DecreaseRepeatButton>
                                    <RepeatButton BorderThickness="0"
                                                  Height="8">

                                        <RepeatButton.Background>
                                            <LinearGradientBrush StartPoint="0,0"
                                                                 EndPoint="1,0">
                                                <GradientStop Color="#00E5FF" Offset="0"/>
                                                <GradientStop Color="#8B5CF6" Offset="0.5"/>
                                                <GradientStop Color="#FF2CDF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </RepeatButton.Background>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>

                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Background="Transparent"
                                                  BorderThickness="0"
                                                  Height="8"/>
                                </Track.IncreaseRepeatButton>

                                <Track.Thumb>
                                    <Thumb Width="20"
                                           Height="20">

                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">

                                                <Ellipse Fill="#F8FAFC"
                                                         Stroke="#00E5FF"
                                                         StrokeThickness="2">

                                                    <Ellipse.Effect>
                                                        <DropShadowEffect BlurRadius="16"
                                                                          ShadowDepth="0"
                                                                          Color="#00E5FF"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- TITLES -->

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A5F3FC"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

    </Window.Resources>


    <!-- MAIN -->

    <Grid Background="{StaticResource MainBackground}">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="90"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="430"/>
        </Grid.ColumnDefinitions>


        <!-- SIDEBAR -->

        <Border Grid.Column="0"
                Background="#10000000"
                BorderBrush="#15FFFFFF"
                BorderThickness="0,0,1,0">

            <StackPanel Margin="14">

                <Border Width="58"
                        Height="58"
                        CornerRadius="18"
                        Margin="0,10,0,28">

                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0"
                                             EndPoint="1,1">
                            <GradientStop Color="#00E5FF" Offset="0"/>
                            <GradientStop Color="#8B5CF6" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>

                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20"
                                          ShadowDepth="0"
                                          Color="#8B5CF6"/>
                    </Border.Effect>

                    <TextBlock Text="IL"
                               Foreground="White"
                               FontWeight="Bold"
                               FontSize="22"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <Button Content="📂"
                        Style="{StaticResource NeonButton}"
                        Click="BtnImport_Click"/>

                <Button Content="💾"
                        Style="{StaticResource NeonButton}"
                        Click="BtnSave_Click"/>

                <Button Content="↺"
                        Style="{StaticResource NeonButton}"
                        Click="BtnReset_Click"/>
            </StackPanel>
        </Border>


        <!-- CENTER -->

        <Grid Grid.Column="1"
              Margin="24">

            <Grid.RowDefinitions>
                <RowDefinition Height="72"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="190"/>
            </Grid.RowDefinitions>


            <!-- HEADER -->

            <Border Grid.Row="0"
                    Style="{StaticResource GlassCard}">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <Ellipse Width="10" Height="10" Fill="#FF5F57" Margin="0,0,8,0"/>
                        <Ellipse Width="10" Height="10" Fill="#FEBC2E" Margin="0,0,8,0"/>
                        <Ellipse Width="10" Height="10" Fill="#28C840"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                        <TextBlock Text="IMAGE LAB PRO"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="White">

                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="18"
                                                  ShadowDepth="0"
                                                  Color="#00E5FF"
                                                  Opacity="0.7"/>
                            </TextBlock.Effect>
                        </TextBlock>

                        <TextBlock Text="Advanced Color Processing"
                                   Foreground="#93C5FD"
                                   FontSize="11"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <Border Grid.Column="2"
                            Width="120"
                            Height="36"
                            Background="#0D22C55E"
                            BorderBrush="#204ADE80"
                            BorderThickness="1"
                            CornerRadius="12">

                        <TextBlock Text="● REALTIME"
                                   Foreground="#4ADE80"
                                   FontWeight="Bold"
                                   FontSize="11"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>


            <!-- IMAGE VIEW -->

            <Border Grid.Row="1"
                    Margin="0,22,0,0"
                    Style="{StaticResource GlassCard}"
                    AllowDrop="True"
                    DragOver="ImageControl_DragOver"
                    Drop="ImageControl_Drop">

                <Grid>

                    <Border Height="58"
                            VerticalAlignment="Top"
                            Background="#0B000000"
                            CornerRadius="20,20,0,0">

                        <Grid Margin="18,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="IMAGE VIEWPORT"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       VerticalAlignment="Center"/>

                            <Border Grid.Column="1"
                                    Width="80"
                                    Height="30"
                                    CornerRadius="10">

                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0"
                                                         EndPoint="1,0">
                                        <GradientStop Color="#00E5FF" Offset="0"/>
                                        <GradientStop Color="#8B5CF6" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>

                                <TextBlock Text="LIVE"
                                           Foreground="White"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>


                    <StackPanel x:Name="PlaceholderText"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                        <TextBlock Text="DROP IMAGE HERE"
                                   Foreground="#70FFFFFF"
                                   FontWeight="Bold"
                                   FontSize="40"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Drag &amp; Drop or Import"
                                   Foreground="#64748B"
                                   FontSize="15"
                                   Margin="0,12,0,0"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>


                    <Image x:Name="DisplayedImage"
                           Margin="24,72,24,24"
                           Stretch="Uniform"
                           Cursor="Cross"
                           MouseLeftButtonDown="DisplayedImage_MouseLeftButtonDown"/>
                </Grid>
            </Border>


            <!-- INFO BAR -->

            <Border Grid.Row="2"
                    Margin="0,22,0,0"
                    Style="{StaticResource GlassCard}">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="FILE"
                                   Foreground="#64748B"
                                   FontSize="10"
                                   FontWeight="Bold"/>

                        <TextBlock x:Name="TxtFileName"
                                   Foreground="White"
                                   Margin="0,10,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="SIZE"
                                   Foreground="#64748B"
                                   FontSize="10"
                                   FontWeight="Bold"/>

                        <TextBlock x:Name="TxtFileSize"
                                   Foreground="White"
                                   Margin="0,10,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="DIMENSIONS"
                                   Foreground="#64748B"
                                   FontSize="10"
                                   FontWeight="Bold"/>

                        <TextBlock x:Name="TxtDimensions"
                                   Foreground="White"
                                   Margin="0,10,0,0"/>
                    </StackPanel>

                    <Grid Grid.Column="3">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>

                            <Border x:Name="SelectedColorPreview"
                                    Width="76"
                                    Height="76"
                                    CornerRadius="18"
                                    BorderBrush="#00E5FF"
                                    BorderThickness="2"
                                    Background="#1E293B"/>

                            <TextBlock x:Name="HexColorText"
                                       Text="#FFFFFF"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       FontSize="18"
                                       Margin="0,12,0,0"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Margin="14,0,0,0">

                            <Border Background="#0BFFFFFF"
                                    CornerRadius="12"
                                    Padding="10"
                                    Margin="0,0,0,8">

                                <Grid>
                                    <TextBlock Text="RGB"
                                               Foreground="#60A5FA"
                                               FontWeight="Bold"/>

                                    <TextBlock x:Name="RgbLabel"
                                               Text="(0,0,0)"
                                               Foreground="White"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>

                            <Border Background="#0BFFFFFF"
                                    CornerRadius="12"
                                    Padding="10"
                                    Margin="0,0,0,8">

                                <Grid>
                                    <TextBlock Text="HSV"
                                               Foreground="#4ADE80"
                                               FontWeight="Bold"/>

                                    <TextBlock x:Name="HsvLabel"
                                               Text="(0°,0%,0%)"
                                               Foreground="White"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>

                            <Border Background="#0BFFFFFF"
                                    CornerRadius="12"
                                    Padding="10"
                                    Margin="0,0,0,8">

                                <Grid>
                                    <TextBlock Text="YCbCr"
                                               Foreground="#FBBF24"
                                               FontWeight="Bold"/>

                                    <TextBlock x:Name="YcbcrLabel"
                                               Text="(0,0,0)"
                                               Foreground="White"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>

                            <Border Background="#0BFFFFFF"
                                    CornerRadius="12"
                                    Padding="10">

                                <Grid>
                                    <TextBlock Text="CMYK"
                                               Foreground="#F472B6"
                                               FontWeight="Bold"/>

                                    <TextBlock x:Name="CmykLabel"
                                               Text="(0%,0%,0%,100%)"
                                               Foreground="White"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>


        <!-- RIGHT PANEL -->

        <Border Grid.Column="2"
                Background="#0A000000"
                BorderBrush="#15FFFFFF"
                BorderThickness="1,0,0,0">

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Padding="20">

                <StackPanel>

                    <!-- ADJUSTMENTS -->

                    <Border Style="{StaticResource GlassCard}"
                            Margin="0,0,0,18">

                        <StackPanel>

                            <TextBlock Text="IMAGE ADJUSTMENTS"
                                       Style="{StaticResource SectionTitle}"/>

                            <TextBlock Text="Brightness"
                                       Foreground="White"/>

                            <Slider x:Name="BrightnessSlider"
                                    Style="{StaticResource ModernSlider}"
                                    Minimum="-1"
                                    Maximum="1"
                                    Value="0"
                                    ValueChanged="Slider_ValueChanged"
                                    Margin="0,6,0,14"/>

                            <TextBlock Text="Contrast"
                                       Foreground="White"/>

                            <Slider x:Name="ContrastSlider"
                                    Style="{StaticResource ModernSlider}"
                                    Minimum="-1"
                                    Maximum="1"
                                    Value="0"
                                    ValueChanged="Slider_ValueChanged"/>
                        </StackPanel>
                    </Border>


                    <!-- COLOR SPACES -->

                    <Border Style="{StaticResource GlassCard}"
                            Margin="0,0,0,18">

                        <StackPanel>

                            <TextBlock Text="COLOR SPACES"
                                       Style="{StaticResource SectionTitle}"/>

                            <Button Content="GRAYSCALE"
                                    Background="#18FFFFFF"
                                    Style="{StaticResource NeonButton}"
                                    Click="BtnGrayscale_Click"/>

                            <Button Content="HSV SHIFT"
                                    Background="#222A145E"
                                    Style="{StaticResource NeonButton}"
                                    Click="BtnToHSV_Click"/>

                            <Button Content="CMYK"
                                    Background="#221D4ED8"
                                    Style="{StaticResource NeonButton}"
                                    Click="BtnToCMYK_Click"/>

                            <Button Content="YCbCr"
                                    Background="#220EA5E9"
                                    Style="{StaticResource NeonButton}"
                                    Click="BtnToYCbCr_Click"/>

                            <Button Content="CIELab"
                                    Background="#2214B8A6"
                                    Style="{StaticResource NeonButton}"
                                    Click="BtnToLab_Click"/>

                            <Button Content="YUV"
                                    Background="#223256D8"
                                    Style="{StaticResource NeonButton}"
                                    Click="BtnToYUV_Click"/>

                            <Button Content="EXTRACT RED CHANNEL"
                                    Background="#66DC2626"
                                    Style="{StaticResource NeonButton}"
                                    Click="BtnExtractRed_Click"/>
                        </StackPanel>
                    </Border>


                    <!-- CHANNELS -->

                    <Border Style="{StaticResource GlassCard}"
                            Margin="0,0,0,18">

                        <StackPanel>

                            <TextBlock x:Name="TxtChannelsTitle"
                                       Text="RGB CHANNELS &amp; QUANTIZATION"
                                       Style="{StaticResource SectionTitle}"/>

                            <TextBlock x:Name="LblCh1"
                                       Text="Red Channel"
                                       Foreground="White"/>

                            <Slider x:Name="SliderCh1"
                                    Style="{StaticResource ModernSlider}"
                                    Minimum="0"
                                    Maximum="2"
                                    Value="1"
                                    ValueChanged="ChannelSlider_ValueChanged"
                                    Margin="0,6,0,14"/>

                            <TextBlock x:Name="LblCh2"
                                       Text="Green Channel"
                                       Foreground="White"/>

                            <Slider x:Name="SliderCh2"
                                    Style="{StaticResource ModernSlider}"
                                    Minimum="0"
                                    Maximum="2"
                                    Value="1"
                                    ValueChanged="ChannelSlider_ValueChanged"
                                    Margin="0,6,0,14"/>

                            <TextBlock x:Name="LblCh3"
                                       Text="Blue Channel"
                                       Foreground="White"/>

                            <Slider x:Name="SliderCh3"
                                    Style="{StaticResource ModernSlider}"
                                    Minimum="0"
                                    Maximum="2"
                                    Value="1"
                                    ValueChanged="ChannelSlider_ValueChanged"
                                    Margin="0,6,0,14"/>

                            <DockPanel Margin="0,0,0,6">

                                <TextBlock Text="Quantization Levels"
                                           Foreground="White"/>

                                <TextBlock x:Name="lblLevels"
                                           Text="256"
                                           Foreground="#60A5FA"
                                           FontWeight="Bold"
                                           DockPanel.Dock="Right"/>
                            </DockPanel>

                            <Slider x:Name="SliderLevels"
                                    Style="{StaticResource ModernSlider}"
                                    Minimum="2"
                                    Maximum="256"
                                    Value="256"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    ValueChanged="SliderLevels_ValueChanged"/>
                        </StackPanel>
                    </Border>


                    <!-- 3D RGB -->

                    <Border Style="{StaticResource GlassCard}">

                        <StackPanel>

                            <TextBlock Text="3D RGB SPACE"
                                       Style="{StaticResource SectionTitle}"/>

                            <Border Height="240"
                                    Background="#10000000"
                                    BorderBrush="#14FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="22">

                                <h:HelixViewport3D x:Name="RgbViewport"
                                                   Background="Transparent"
                                                   ZoomExtentsWhenLoaded="True">

                                    <h:SunLight/>
                                </h:HelixViewport3D>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
